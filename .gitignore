# Local test library built by tools/build_test_library.py.
# ~29 GB of APFS clones -- reproducible from the ES-DE source, never committed.
/library/

# Local credentials and persisted device identity. See config.example.toml.
/config.toml
/state.json
# What each save state looked like at the last sync — local bookkeeping.
/states-seen.json

# Personal save/state data used as scanner test input — not ours to commit.
/Saves/

# Metadata cache — regenerate with `cargo run -- sync`.
/cache.sqlite3
/cache.sqlite3-*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Rust build artifacts
/target/

# Built app bundle — rebuild with `npx tauri build`.
# The built bundle lives at the project root so it can be launched directly
# and symlinked into ~/Applications/MooseStack. Never committed.
/*.app/
/*.app

# Device export duplicated at data/vendor/device-export/ — these root copies
# are scratch and get deleted once extraction is confirmed.
/es_systems.xml
/es_find_rules.xml
/es_settings.xml

# Mobile icon sets tauri-icon emits; we only ship desktop.
/src-tauri/gen/android/

# Node / Tauri
node_modules/
dist/
build/
src-tauri/target/
# Generated by tauri-build from tauri.conf.json on every build.
/src-tauri/gen/

# macOS
.DS_Store

# Regenerated by tools/make_icon.py on every run.
src-tauri/icons/icon.iconset/
# Likewise, by tools/make_macos_icon.py. Only the .icns it produces is tracked.
src-tauri/icons/macos.iconset/

# Generated RetroArch core options and remaps (regenerated per launch).
/library/retroarch/

# A stray cache the GUI creates when it is run with src-tauri as the working
# directory. Always empty, always regenerated.
/src-tauri/cache.sqlite3

# Loose ROMs dropped in the project root for inspection.
/*.zip
/*.7z
/*.chd

# local safety copies of gamelists/settings before edits
backups/

# Backups of files taken from outside the project. Personal config, not
# ours to publish — kept on disk, out of the history.
backups/

# Inventory of the external game drive. The gzipped manifest and the summary
# are kept, because regenerating them needs the 12 TB drive physically plugged
# in and everything downstream — what is missing, what to fetch, what to copy —
# is answerable without it. The 8.8 MB expanded copy and the derived reports are
# not kept; `gunzip -k` and the tools rebuild them.
/drive-manifest/*
!/drive-manifest/manifest.jsonl.gz
!/drive-manifest/summary.json
!/drive-manifest/README.md

# One-off cleanup script generated for the romM library. Local, not ours to ship.
/romm-remove.sh
/remove-what-claude-added.sh
/remove-your-old-games.sh
/remove-junk.sh
/remove-veronica.sh
