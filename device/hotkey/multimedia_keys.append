# moose-patch: L2+R2 opens the addon. Both orderings, because either shoulder
# may go down first; the script debounces the second one.
BTN_TR2+BTN_TL2 1            /userdata/system/moose-patch/moose-launch.sh --hotkey
BTN_TL2+BTN_TR2 1            /userdata/system/moose-patch/moose-launch.sh --hotkey
