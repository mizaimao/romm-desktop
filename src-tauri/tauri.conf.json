{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RomM-Desktop",
  "identifier": "net.zhenningzhang.romm-desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "RomM Desktop",
        "width": 1500,
        "height": 950,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/**",
          "**"
        ]
      }
    },
    "withGlobalTauri": true,
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../data/esde-core-map.json"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
